          "elements": [
            {
              "id": "3c10ac2",
              "elType": "widget",
              "widgetType": "nexia_reveal_heading",
              "settings": {
                "kicker": "Sala de máquinas",
                "title": "Somos Nexia: el equipo que entra en la sala de máquinas",
                "text": "",
                "align": "left"
