          "elements": [
            {
              "id": "e185f10",
              "elType": "widget",
              "widgetType": "nexia_reveal_heading",
              "settings": {
                "kicker": "Método NEXIA™",
                "title": "Liberamos la operativa de tu negocio digital",
                "text": "",
                "align": "center"
              },
              "elements": []
            },
            {
              "id": "48dda25",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n    <div style=\"background:#050b14; padding:0 24px 32px; font-family:'Inter', ui-sans-serif, system-ui, sans-serif;\n      color:#f2f6f9; max-width:1120px; margin:0 auto;\">\n      <p style=\"color:#f2f6f9; font-size:19px; line-height:1.65; max-width:720px; max-width:760px; margin:0 auto;\">Esto puede parecer complejo, pero lo que hacemos es sumergirnos y descubrir qué sobra en tu sistema, qué falla y qué sigue dependiendo innecesariamente de ti. Para eso trabajamos con nuestro Método NEXIA™.</p>\n    </div>\n    "
              },
              "elements": []
            },
            {
              "id": "63485fc",
              "elType": "widget",
              "widgetType": "nexia_method_steps",
              "settings": {
                "steps": [
                  {
                    "_id": "034c8b6",
                    "number": "01",
                    "title": "Detectamos",
                    "body": "Localizamos tareas duplicadas, procesos manuales y puntos donde tu negocio sigue necesitando tu intervención.",
                    "sub": "Para descubrir dónde sigues siendo imprescindible sin necesitar serlo."
                  },
                  {
                    "_id": "54ab255",
                    "number": "02",
                    "title": "Ordenamos",
                    "body": "Ponemos estructura en procesos, herramientas, responsabilidades, documentación y flujos de trabajo.",
                    "sub": "Para que tu negocio deje de vivir exclusivamente dentro de tu cabeza."
                  },
                  {
                    "_id": "dc13ce0",
                    "number": "03",
                    "title": "Implementamos",
                    "body": "Creamos automatizaciones y sistemas operativos que funcionan en el día a día. Incorporamos Inteligencia Artificial cuando aporta valor.",
                    "sub": "Olvidarte de estar pendiente 24/7, eso es Liberación Operativa."
                  }
                ]
              },
              "elements": []
            },
            {
              "id": "e425cf7",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n    <div style=\"background:#050b14; padding:32px 24px 96px; font-family:'Inter', ui-sans-serif, system-ui, sans-serif;\n      color:#f2f6f9; max-width:1120px; margin:0 auto;\">\n      \n    <div style=\"display:flex; justify-content:center; margin-top:8px;\">\n      <a href=\"https://app.somosnexia.com/demo\" style=\"display:inline-flex; align-items:center; gap:8px;\n        border-radius:999px; padding:15px 28px; font-weight:600; font-size:14px;\n        letter-spacing:0.02em; text-transform:uppercase; background:#ffb15c;\n        color:#180d02; text-decoration:none; font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif;\">\n        Quiero saber qué está frenando mi negocio <span aria-hidden=\"true\">&rarr;</span>\n      </a>\n    </div>\n    \n    </div>\n    "
