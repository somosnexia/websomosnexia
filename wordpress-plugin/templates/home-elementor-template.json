            "_column_size": 50
          },
          "elements": [
            {
              "id": "8013dfa",
              "elType": "widget",
              "widgetType": "nexia_reveal_heading",
              "settings": {
                "kicker": "Sala de máquinas",
                "title": "Somos Nexia: el equipo que entra en la sala de máquinas",
                "text": "",
                "align": "left"
              },
              "elements": []
            },
            {
              "id": "0bf4100",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n    <div style=\"background:#ffffff; padding:0 24px; font-family:'Poppins', ui-sans-serif, system-ui, sans-serif;\n      color:#14213d; max-width:1120px; margin:0 auto;\">\n      <p style=\"color:#5b6474; font-size:18px; line-height:1.65; max-width:720px; \">Somos Pilar y Laura. Creamos Somos Nexia porque vimos crecer demasiados negocios: en clientes, herramientas, equipo y facturación, mientras sus dueñas tenían cada vez menos tiempo para dirigir.</p><p style=\"color:#5b6474; font-size:18px; line-height:1.65; max-width:720px; \">Nosotras entramos justo ahí: en la operativa que no se ve, ordenando procesos, sistemas, automatizaciones, documentación, integraciones e Inteligencia Artificial cuando aporta valor, para que el negocio avance sin depender de ti para todo.</p><p style=\"font-family:'Poppins', ui-sans-serif, system-ui, sans-serif; font-size:20px; font-weight:600; color:#14213d; margin-top:12px;\">Tú marcas el rumbo.<br>Nosotras ejecutamos.</p>\n    </div>\n    "
              },
              "elements": []
            }
          ]
        },
        {
          "id": "6852184",
          "elType": "column",
          "settings": {
            "_column_size": 50
          },
          "elements": [
            {
              "id": "70d21e5",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n    <div style=\"background:#ffffff; padding:0 24px; font-family:'Poppins', ui-sans-serif, system-ui, sans-serif;\n      color:#14213d; max-width:1120px; margin:0 auto;\">\n      \n    <div style=\"background:#ffffff; border:1px solid #e3e7f3; border-radius:24px; padding:32px;\">\n      <h3 style=\"font-family:'Poppins', ui-sans-serif, system-ui, sans-serif; font-size:24px; font-weight:700; color:#2547f5; margin:0 0 16px;\">\n        Crecer también implica decidir qué huella dejamos\n      </h3>\n      <p style=\"color:#5b6474; font-size:16px; line-height:1.65;\">\n        El océano forma parte del universo de Somos Nexia, pero no queremos que se quede solo en una\n        metáfora. Por eso destinamos parte de nuestro compromiso como empresa a iniciativas vinculadas\n        con la regeneración y conservación de los ecosistemas marinos. Porque crecer mejor también\n        significa construir negocios más sostenibles y devolver parte de lo que generamos.\n      </p>\n      <p style=\"font-family:'Poppins', ui-sans-serif, system-ui, sans-serif; font-size:18px; font-weight:600; color:#2547f5; margin-top:16px;\">\n        Crecer sí. Pero no a cualquier precio.\n      </p>\n    </div>\n    \n    </div>\n    "
              },
              "elements": []
            }
          ]
        }
      ]
    },
