          },
          "elements": [
            {
              "id": "cececcf",
              "elType": "widget",
              "widgetType": "nexia_reveal_heading",
              "settings": {
                "kicker": "Método NEXIA™",
                "title": "Liberamos la operativa de tu negocio digital",
                "text": "",
                "align": "center"
              },
              "elements": []
            },
            {
              "id": "8012f2f",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n    <div style=\"background:#05070d; padding:0 24px 32px; font-family:'Poppins', ui-sans-serif, system-ui, sans-serif;\n      color:#f2f5fb; max-width:1120px; margin:0 auto;\">\n      <p style=\"color:#f2f5fb; font-size:19px; line-height:1.65; max-width:720px; max-width:760px; margin:0 auto;\">Esto puede parecer complejo, pero lo que hacemos es sumergirnos y descubrir qué sobra en tu sistema, qué falla y qué sigue dependiendo innecesariamente de ti. Para eso trabajamos con nuestro Método NEXIA™.</p>\n    </div>\n    "
              },
              "elements": []
            },
            {
              "id": "e7a1bb0",
              "elType": "widget",
              "widgetType": "nexia_method_steps",
              "settings": {
                "steps": [
                  {
                    "_id": "25b14dd",
                    "number": "01",
                    "title": "Detectamos",
                    "body": "Localizamos tareas duplicadas, procesos manuales y puntos donde tu negocio sigue necesitando tu intervención.",
                    "sub": "Para descubrir dónde sigues siendo imprescindible sin necesitar serlo."
                  },
                  {
                    "_id": "be38f8f",
                    "number": "02",
                    "title": "Ordenamos",
                    "body": "Ponemos estructura en procesos, herramientas, responsabilidades, documentación y flujos de trabajo.",
                    "sub": "Para que tu negocio deje de vivir exclusivamente dentro de tu cabeza."
                  },
                  {
                    "_id": "6f8c13e",
                    "number": "03",
                    "title": "Implementamos",
                    "body": "Creamos automatizaciones y sistemas operativos que funcionan en el día a día. Incorporamos Inteligencia Artificial cuando aporta valor.",
                    "sub": "Olvidarte de estar pendiente 24/7, eso es Liberación Operativa."
                  }
                ]
              },
              "elements": []
            },
            {
              "id": "8323ee1",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n    <div style=\"background:#05070d; padding:32px 24px 96px; font-family:'Poppins', ui-sans-serif, system-ui, sans-serif;\n      color:#f2f5fb; max-width:1120px; margin:0 auto;\">\n      \n    <div style=\"display:flex; justify-content:center; margin-top:8px;\">\n      <a href=\"https://app.somosnexia.com/demo\" style=\"display:inline-flex; align-items:center; gap:10px;\n        border-radius:4px; padding:15px 28px; font-weight:500; font-size:14px;\n        letter-spacing:0.04em; text-transform:uppercase; background:#2e4be2;\n        color:#f2f5fb; text-decoration:none; font-family:'Poppins', ui-sans-serif, system-ui, sans-serif;\">\n        Quiero saber qué está frenando mi negocio <span aria-hidden=\"true\">&rarr;</span>\n      </a>\n    </div>\n    \n    </div>\n    "
              },
              "elements": []
            }
          ]
        }
