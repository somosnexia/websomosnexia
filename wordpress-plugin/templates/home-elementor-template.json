                "kicker": "",
                "title": "Esto no es para todo el mundo",
                "text": "",
                "align": "center"
              },
              "elements": []
            },
            {
              "id": "2ba4215",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n    <div style=\"background:#ffffff; padding:0 24px 96px; font-family:'Poppins', ui-sans-serif, system-ui, sans-serif;\n      color:#14213d; max-width:1120px; margin:0 auto;\">\n      <ul style=\"color:#14213d; font-size:17px; line-height:1.6; padding-left:22px; max-width:720px;\"><li style=\"margin-bottom:10px;\">No somos una formación para aprender a emprender.</li><li style=\"margin-bottom:10px;\">No instalamos herramientas simplemente porque estén de moda.</li><li style=\"margin-bottom:10px;\">No llenamos tu negocio de automatizaciones que después nadie sabe mantener.</li><li style=\"margin-bottom:10px;\">Y no creemos que contratar más personas sea automáticamente la solución.</li></ul><p style=\"color:#5b6474; font-size:18px; line-height:1.65; max-width:720px; margin-top:16px;\">Trabajamos sobre un negocio que ya existe. Miramos qué está pasando bajo la superficie. Y si no necesitas a Nexia, mejor saberlo antes de que saques la tarjeta.</p><p style=\"font-family:'Poppins', ui-sans-serif, system-ui, sans-serif; font-size:26px; font-weight:600; color:#2547f5; text-align:center; margin-top:20px;\">Quitamos dependencia.</p>\n    </div>\n    "
              },
              "elements": []
            }
          ]
        }
      ]
    },
